{
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.sheetjs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://api.qrserver.com; media-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), autoplay=(), fullscreen=(), interest-cohort=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/api/roster",
      "destination": "/api/publish?resource=roster"
    },
    {
      "source": "/api/reminder",
      "destination": "/api/cron?job=reminder"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron?job=reminder",
      "schedule": "0 20 * * 1"
    }
  ]
}
